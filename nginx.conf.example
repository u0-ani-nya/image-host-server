server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name img.ani-nya.com;  # 改成你的域名

    ssl_certificate /root/.acme.sh/img.ani-nya.com_ecc/img.ani-nya.com.pem;
    ssl_certificate_key /root/.acme.sh/img.ani-nya.com_ecc/img.ani-nya.com.key;

    client_max_body_size 10M;

    root /mnt/slab/www/app/api/image-host-server;
    index index.php;

    # 静态文件直接返回，其他全部交给 PHP
    location / {
        try_files $uri $uri/ @php;
    }

    # PHP 处理（保留原始路径作为 PATH_INFO）
    location ~ \.php(/|$) {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include snippets/fastcgi-php.conf;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_pass 127.0.0.1:9000;
    }

    # 找不到文件时，交给 index.php，原始路径作为 PATH_INFO
    location @php {
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param PATH_INFO $uri;
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
    }

    # 禁止访问配置文件和数据目录
    location ~ /(config\.php|data/) { deny all; }
}
